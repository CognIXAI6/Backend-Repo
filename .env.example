# Application
NODE_ENV=development
PORT=3000
# Port for the separate voice-gateway process (src/main-gateway.ts, run via
# `ecosystem.config.js`'s "ai-voice-gateway" PM2 app) — nginx must route
# /socket.io/* to this port and everything else to PORT above. Defaults to
# PORT+1 if unset; set explicitly in production.
VOICE_GATEWAY_PORT=3002
API_PREFIX=api
API_VERSION=v1
# Used to protect admin-only endpoints (e.g. POST /payment/admin/bulk-sync).
# Set to any long random string — keep it secret.
ADMIN_SECRET=

# Database
DATABASE_HOST=
DATABASE_PORT=
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

# Email - Resend
RESEND_API_KEY=re_xxxxxxxxxxxx

# Email - Nodemailer (fallback)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# Email Settings
EMAIL_FROM=
EMAIL_FROM_NAME=

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:3001

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs are no longer set here. Each plan's Stripe price is created and
# rotated automatically when an admin publishes a pricing change — see
# POST /admin/plans/:id/publish (StripeSyncService) — and stored on
# subscription_plans.stripe_price_id.

# Flutterwave (for African countries)
# Get these from your Flutterwave dashboard → Settings → API
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
# Set this to the exact string you configure as "Secret Hash" in the Flutterwave
# dashboard under Webhooks. This is what we compare against the verif-hash header.
FLUTTERWAVE_WEBHOOK_SECRET=

# Geo detection (ipinfo.io)
# Free tier: 50,000 requests/month — sign up at ipinfo.io to get a token.
# Leave blank to use the unauthenticated endpoint (lower rate limit).
IPINFO_TOKEN=

# Clerk (OAuth / social login)
# Get these from https://dashboard.clerk.com → API Keys
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxx
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx

# Voice Verification Service (speaker biometrics)
# Base URL without trailing slash — e.g. https://voice-api.example.com
VOICE_VERIFICATION_URL=http://localhost:8000
ADMIN_PORTAL_URL=

FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}